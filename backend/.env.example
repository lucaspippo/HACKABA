# Copiá este archivo a .env y completá la clave.
# Sin la clave, Ángela funciona en modo fallback (resuelve las consultas clave
# directo sobre los datos, sin conversación libre).

# LLM_PROVIDER=anthropic|gateway (opcional). Sin setear, se autodetecta: hay
# ANTHROPIC_API_KEY -> anthropic; si no, hay AI_GATEWAY_API_KEY -> gateway.

# Opción (a): directo contra Anthropic.
ANTHROPIC_API_KEY=

# Opción (b):
# --- Gateway (Vercel/V0) ---
# El token va como `Authorization: Bearer`, no como `x-api-key`. Si lo
# completás, dejá ANTHROPIC_API_KEY vacía. GATEWAY_MODEL le gana a ANGELA_MODEL
# cuando el proveedor activo es el gateway (los slugs del gateway llevan
# prefijo de provider y versión con punto).
AI_GATEWAY_API_KEY=
GATEWAY_MODEL=anthropic/claude-sonnet-5
# Base URL del gateway (opcional). Default: https://ai-gateway.vercel.sh
AI_GATEWAY_BASE_URL=

# Modelo para el camino directo (opcional). Más rápido/barato: claude-haiku-4-5.
# Por el Gateway usá GATEWAY_MODEL de arriba, no esta: el slug de allá lleva
# provider y versión con puntos (anthropic/claude-sonnet-4.6).
ANGELA_MODEL=claude-sonnet-4-6

# DATABASE_URL: the ADMIN connection. Used by Alembic (needs to create/alter
# tables, extensions, policies) and by admin-only queries (looking up/creating
# tenant rows). Local dev default matches docker-compose.yml's superuser.
# Production: Supabase pooler URL, transaction mode, port 6543, sslmode=require.
# Host port is 5434, matching docker-compose.yml — not 5432.
DATABASE_URL=postgresql+psycopg://polpilot:polpilot@localhost:5434/polpilot

# APP_DATABASE_URL: the connection every tenant-scoped query goes through
# (core.db.engine.get_engine/tenant_connection). MUST be a role WITHOUT the
# BYPASSRLS attribute and without superuser — RLS policies are silently
# skipped for any role that has either (this includes the DATABASE_URL role
# above, and Supabase's default `postgres` role in production). Local dev
# default matches the polpilot_app role docker/init-app-role.sql creates.
# Production: create an equivalent restricted role in Supabase and point this
# at it — never reuse the admin/pooler-owner connection here.
APP_DATABASE_URL=postgresql+psycopg://polpilot_app:polpilot_app@localhost:5434/polpilot

# ODOO_ENCRYPTION_KEY: symmetric key (Fernet) used to encrypt each tenant's
# Odoo API key at rest in odoo_connections.api_key_encrypted (core/db/
# odoo_connections_repo.py). Generate one per environment and never rotate it
# without re-encrypting existing rows first:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ODOO_ENCRYPTION_KEY=

# WHATSAPP_ENCRYPTION_KEY: symmetric key (Fernet) used to encrypt each
# tenant's WhatsApp Business Cloud API access token and app secret at rest
# (whatsapp_channels.access_token_encrypted/app_secret_encrypted, core/db/
# whatsapp_repo.py). Generate one per environment, same as ODOO_ENCRYPTION_KEY
# above and never rotate it without re-encrypting existing rows first:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WHATSAPP_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Identidad de la instancia y datos del demo
# ---------------------------------------------------------------------------
# Qué tenant sirve este proceso. `demo` = Distribuidora del Litoral (empresa
# 100% ficticia, generada con semilla fija). Uno por proceso: el multi-tenant
# es por deployment, no por request.
POLPILOT_TENANT=demo

# Dónde vive el dataset de ese tenant. Relativo a backend/ o absoluto.
POLPILOT_DATA_DIR=../data-demo

# EL "HOY" CONGELADO. Sin esto, los análisis se corren contra la fecha real y
# el dataset sembrado (que termina el 2026-07-06) queda viejo: los cruces
# dejan de emitir porque sus notas caen fuera de la ventana de 30 días.
# Con esto, la demo da los mismos números hoy, mañana y el día de la
# grabación. NO es opcional para el demo.
POLPILOT_DEMO_TODAY=2026-07-07

# Contraseña fija de los usuarios sembrados del demo. seed_db la re-afirma en
# cada siembra. Cambiala en cualquier deployment alcanzable desde afuera.
POLPILOT_DEMO_PASSWORD=demo-password

# Entrar directo como el dueño, sin pantalla de login (cómodo para la demo).
POLPILOT_DEMO_AUTOLOGIN=1
# Permitir cambiar de rol desde la UI para mostrar la vista de cada oficio.
POLPILOT_DEMO_ROLE_SWITCH=1

# Idioma por defecto del tenant (es|en). La preferencia por usuario lo pisa.
POLPILOT_DEFAULT_LANG=es

# ---------------------------------------------------------------------------
# Evals: APAGADOS por defecto, a propósito
# ---------------------------------------------------------------------------
# Correr las suites recomputa todos los hallazgos (tres veces, por la de
# determinismo) y tarda. En una demo eso es latencia. El panel del producto
# sólo LEE la última corrida grabada (data-demo/evals_run.json) y nunca
# calcula. Para correrlas a propósito, y sólo entonces:
#   POLPILOT_EVALS=1 py backend/scripts/run_evals.py
# POLPILOT_EVALS=
