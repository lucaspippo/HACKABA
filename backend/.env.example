# Copiá este archivo a .env y completá la clave.
# Sin la clave, Ángela funciona en modo fallback (resuelve las consultas clave
# directo sobre los datos, sin conversación libre).

ANTHROPIC_API_KEY=

# Modelo de Ángela (opcional). Default: claude-sonnet-4-6
# Para respuestas más rápidas/baratas: claude-haiku-4-5
ANGELA_MODEL=claude-sonnet-4-6

# Local dev default matches docker-compose.yml. Production: Supabase pooler URL,
# transaction mode, port 6543, sslmode=require. Connect using a role WITHOUT the
# BYPASSRLS attribute — the RLS policies added in later migrations are silently
# skipped for any role that has it (including Supabase's default superuser).
DATABASE_URL=postgresql+psycopg://polpilot:polpilot@localhost:5432/polpilot
