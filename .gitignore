# Secretos y credenciales — JAMÁS al repo.
.env
*.env
!.env.example
backend/credenciales.json
# data-demo/credenciales.json ya no existe: las credenciales viven hasheadas en
# Postgres (auth_credentials) y el plaintext no se persiste nunca. Se mantiene
# el patrón por si un checkout viejo dejó el archivo huérfano dando vueltas.
credenciales.json

# Dependencias y builds
node_modules/
frontend/dist/
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Data dirs de OTROS tenants (si alguien monta uno local, no se versiona).
data/

# Runtime del DEMO (los seeds generados sí se versionan; el estado vivo no)
data-demo/versions/
data-demo/audit.json
data-demo/inventory_actual.json
data-demo/memoria.json
data-demo/staging.json
data-demo/macro_cache.json
data-demo/organizacion.json
data-demo/recordatorios.json
data-demo/perfiles.json
data-demo/notificaciones.json
data-demo/fotos/
data-demo/documentos/
data-demo/caja.json
data-demo/contexto.json
data-demo/odoo_demo_conectado.json

# Estado vivo de la cobranza y de la autonomía de Ángela (P42/E-F): se genera
# al aprobar una gestión o al mover la perilla. Nunca se versiona.
data-demo/cobranza.json
data-demo/autonomia.json

# Adjuntos que sube el piso (prueba de entrega, fotos de faltantes): runtime.
data-demo/piso_adjuntos/

# Capturas locales de los scripts de verificación
frontend/shots/
frontend/*.png

# Sistema
.DS_Store
Thumbs.db
desktop.ini

# Isolated worktrees for in-progress feature work (superpowers:using-git-worktrees)
.worktrees/

# Visual companion / brainstorm session files (local only)
.superpowers/

# La corrida de evals del tenant piloto/real NO va al repo: es una medición
# de los datos de un cliente. La del demo SÍ va versionada (data-demo/
# evals_run.json), y es a propósito: los evals están apagados por defecto
# (core/evals.py, FLAG_EVALS), así que el panel sólo puede mostrar algo si la
# última corrida viaja con el repo. Un clon nuevo enseña el número sin
# calcular nada.
data/evals_run.json
